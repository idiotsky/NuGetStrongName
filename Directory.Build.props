<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Every owned assembly is strong-named with the tool's own build key, never a consumer key. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Key/NuGetStrongName.snk</AssemblyOriginatorKeyFile>
    <ToolVersion>0.1.0</ToolVersion>
    <Version>$(ToolVersion)</Version>
    <Authors>Fei Xu</Authors>
  </PropertyGroup>
</Project>
